# Google Service Account Credentials
# Cách 1: Dán toàn bộ nội dung file JSON của Service Account vào biến dưới dạng chuỗi (Khuyên dùng khi deploy lên Vercel)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com"}

# Cách 2: Tách rời Email và Private Key (tùy chọn)
# GOPOLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID của Thư mục gốc "ARI" trên Google Drive
# Ví dụ từ URL: https://drive.google.com/drive/u/0/folders/1QjVV2u_aiNPriykD1ixD1_h77sb7wUPh
GOOGLE_DRIVE_ROOT_FOLDER_ID=1QjVV2u_aiNPRiykD4ixD1_h77sb7wUPh
